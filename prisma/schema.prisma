// Catering Concierge database schema (Prisma ORM 7, PostgreSQL on Neon).
//
// Connection URLs are not set here: Prisma 7 reads the CLI connection from
// prisma7.config.ts, and the app passes its pooled URL to the Neon driver
// adapter in src/lib/db.ts.
//
// OWNERSHIP IS NOT AUTHORIZATION. Inquiry.restaurantId records which restaurant
// owns a row. Nothing in this schema restricts who can read or change it.
// Authenticated restaurant selection and restaurant-scoped queries must exist
// before any database-backed route or action is exposed.
//
// Authentication models (User, Session, Account, Verification) are at the end.
// A signed-in User has no relation to any Restaurant: signing in grants no
// access to restaurant or inquiry data.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Where an inquiry came from.
enum InquirySource {
  MANUAL
  EMAIL
  WEB_FORM
}

/// Pipeline stage. Mirrors the stages in the dashboard preview (src/lib/demo-data.ts).
enum InquiryStage {
  NEW
  NEEDS_DETAILS
  QUOTING
  AWAITING_CLIENT
  CONFIRMED
}

model Restaurant {
  id          String                 @id @default(uuid(7)) @db.Uuid
  name        String
  createdAt   DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime               @updatedAt @db.Timestamptz(3)
  inquiries   Inquiry[]
  memberships RestaurantMembership[]
}

model Inquiry {
  id           String        @id @default(uuid(7)) @db.Uuid
  /// Owning restaurant. Required. Deleting a restaurant that still has inquiries is blocked (Restrict).
  restaurantId String        @db.Uuid
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  source       InquirySource
  stage        InquiryStage  @default(NEW)

  // Details may be incomplete when an inquiry first arrives, so all are optional.
  eventName    String?
  contactName  String?
  contactEmail String?
  /// Calendar date of the event, without time or time zone.
  eventDate    DateTime?     @db.Date
  guestCount   Int?
  notes        String?

  // Imported inquiries (Zapier pilot). Stored verbatim as untrusted text; no
  // details are extracted from them. The source of an import is MANUAL: Zapier
  // is only the transport.
  /// The inquiry text as originally received.
  inquiryMessage String?
  /// AI-generated review from Zapier. Untrusted plain text that requires human
  /// review. Show it only with that label, and never parse it into fields.
  aiReview       String?
  /// The Zapier Tables table and record this inquiry was imported from. Used only
  /// to prevent duplicate imports.
  zapierTableId  String?
  zapierRecordId String?
  /// True for fictional demonstration data. Set by the server, never from a request.
  isDemo         Boolean @default(false)

  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  // Restaurant-scoped access paths: pipeline by stage, newest first, and upcoming events.
  @@index([restaurantId, stage, createdAt])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, eventDate])
  // One inquiry per imported Zapier record, per restaurant. Retries and
  // concurrent deliveries of the same record can't create a second row.
  // Rows without Zapier IDs (NULLs) never conflict.
  @@unique([restaurantId, zapierTableId, zapierRecordId])
}

// ---------------------------------------------------------------------------
// Authentication (Better Auth 1.7, Google sign-in only)
//
// Field names and required/optional settings follow Better Auth's core schema
// for user, session, account, and verification. tests/auth.test.ts compares
// the generated client against the library's expectations offline.
//
// IDs: the auth config sets advanced.database.generateId = "uuid". On
// PostgreSQL that makes Better Auth omit `id` on insert, so Prisma Client
// fills it from @default(uuid(7)), the same as Restaurant and Inquiry.
// ---------------------------------------------------------------------------

/// A person who has signed in with Google. Not linked to any restaurant.
model User {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  /// The user's restaurant, if they've completed setup. At most one (see RestaurantMembership).
  membership    RestaurantMembership?
}

/// A signed-in browser session. The cookie carries a signed copy of `token`.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

/// A sign-in method linked to a user. Today only Google (providerId "google",
/// accountId = Google's subject ID). Better Auth encrypts accessToken and
/// refreshToken before storage (account.encryptOAuthTokens). idToken stays
/// NULL: the app clears it before every write (see omitIdToken in src/lib/auth.ts).
/// The endpoints that would return tokens to the browser are disabled.
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  /// Part of Better Auth's core schema. Unused: email/password sign-in is disabled.
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

/// Short-lived values Better Auth verifies later, such as OAuth sign-in state.
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Restaurant membership
//
// Links a signed-in User to the Restaurant they belong to. This is the only
// source of a user's restaurant scope: server code resolves it from the
// verified session (src/lib/restaurant-access.ts), never from a restaurant ID
// sent by the browser. Membership is keyed by user ID, not email address.
// ---------------------------------------------------------------------------

/// A member's role in their restaurant. Only OWNER exists today: creating a
/// restaurant makes its creator the owner. There are no staff roles or invitations yet.
enum RestaurantRole {
  OWNER
}

/// One user's membership in one restaurant.
model RestaurantMembership {
  id           String         @id @default(uuid(7)) @db.Uuid
  /// Unique: each user belongs to at most one restaurant. The database enforces
  /// this, so concurrent setup requests can't create a second membership.
  userId       String         @unique @db.Uuid
  /// Deleting a user who still has a membership is blocked (Restrict), so a
  /// restaurant can't silently lose its owner.
  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  restaurantId String         @db.Uuid
  /// Deleting a restaurant that still has members is blocked (Restrict), like inquiries.
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role         RestaurantRole @default(OWNER)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)

  // Lists a restaurant's members and backs the Restrict check when a restaurant is deleted.
  @@index([restaurantId])
}
