# Catering Concierge environment template. Placeholders only.
#
# Copy this file to .env.local and replace every REPLACE_* value with your own
# values (see README: "Database setup" and "Authentication setup"). .env.local
# is ignored by git. Never commit real values or paste them into issues, chats,
# or logs. The app treats any value still containing REPLACE_ as unset.

# Pooled connection (the host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_ENDPOINT-pooler.REPLACE_REGION.aws.neon.tech/REPLACE_DATABASE?sslmode=require"

# Direct (unpooled) connection (no "-pooler" in the host). Used by Prisma CLI
# commands such as migrations.
DIRECT_URL="postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_ENDPOINT.REPLACE_REGION.aws.neon.tech/REPLACE_DATABASE?sslmode=require"

# --- Authentication (Better Auth + Google sign-in) ---------------------------
# Server-only. Never prefix these with NEXT_PUBLIC_.

# Signs session cookies and encrypts stored OAuth access/refresh tokens. At least 32 random
# characters, unique per environment. Generate your own privately, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"

# The app's public origin, with no trailing path. Sign-in builds its Google
# redirect URI from it: <BETTER_AUTH_URL>/api/auth/callback/google
BETTER_AUTH_URL="http://localhost:3000"

# OAuth client (type "Web application") from Google Cloud Console.
GOOGLE_CLIENT_ID="REPLACE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="REPLACE_CLIENT_SECRET"
